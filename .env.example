# Copy this file to .env and adjust as needed.

# Port/host the bridge listens on. Leave HOST unset (default) to bind
# dual-stack ('::'), which accepts both http://127.0.0.1 and http://[::1] --
# "localhost" resolves to the latter on many Windows setups, and n8n's HTTP
# Request node connecting to "localhost" will fail with ECONNREFUSED against
# an IPv4-only bind. The server falls back to 0.0.0.0 (IPv4-only) on its own
# if the host environment has no IPv6 support at all. Set HOST=0.0.0.0
# explicitly only if you specifically need to force IPv4-only.
PORT=3000
# HOST=0.0.0.0

# CORS origin allowed to call this bridge. Use the exact origin n8n runs on
# in production (e.g. http://localhost:5678); "*" is fine for local-only use.
CORS_ORIGIN=*

# Max JSON body size accepted on POST /claude.
MAX_BODY_SIZE=2mb

# Ceiling (ms) for a single /claude call end-to-end. Code generation tasks
# can run for minutes — keep this generous and raise the n8n HTTP Request
# node's timeout to match (n8n's own default is much shorter).
REQUEST_TIMEOUT_MS=900000

# Max agentic turns (tool calls + replies) Claude Code may take per request.
MAX_TURNS=25

# Directory Claude Code treats as its working directory: it can read, write,
# and run shell commands here (and, unless sandboxed further, on the rest of
# the filesystem the process account can reach). Point this at a dedicated
# project/workspace folder, not the bridge's own source directory.
CLAUDE_CWD=C:\claude-workspace

# How tool-use permission prompts are resolved. There is no terminal to
# answer them in a headless server, so 'default' and 'plan' will hang until
# REQUEST_TIMEOUT_MS fires. Options: bypassPermissions | acceptEdits | dontAsk.
# bypassPermissions is the only mode that never blocks; only use it against
# a CLAUDE_CWD you trust running arbitrary commands in. dontAsk is the safer
# choice if you also configure permissions.allow rules for the tools you need.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Optional: pin a specific model instead of the CLI's default.
# CLAUDE_MODEL=claude-sonnet-5

# Optional, only needed if this machine has no interactive `claude login`
# session available to the SDK's bundled binary (e.g. running as a Windows
# service under a different account). Uncomment to authenticate via API key
# instead of the OAuth/keychain session.
# ANTHROPIC_API_KEY=sk-ant-...
